# Optional environment variables. The desktop settings screen encrypts credentials with Windows DPAPI.
# Never commit real credentials. Browser mode keeps settings in memory only.
DASHSCOPE_API_KEY=
# Per-chunk novel analysis timeout in milliseconds (1000..600000, default 240000).
AIFRAME_ANALYSIS_TIMEOUT_MS=240000
# Token Plan is separate from Coding Plan; never reuse one as the other.
TOKEN_PLAN_API_KEY=
GRSAI_API_KEY=
MINIMAX_API_KEY=
# Shared 熊猫Ai relay key for MiniMax H3 and Seedance 2.0 variants.
XIONGMAO_API_KEY=
# Legacy alias retained for existing H3 deployments.
XIONGMAO_MINIMAXH3_API_KEY=
ARK_API_KEY=
# Optional default video model. Supported providers are MiniMax, Xiongmao Ai, and Volcano Ark.
AIFRAME_VIDEO_MODEL=MiniMax-H3
# Optional absolute local data directory:
# AI_FRAME_DATA_DIR=
# Optional absolute local export mirror. The desktop app defaults to an
# `output` folder beside the downloaded executable.
# AI_FRAME_OUTPUT_DIR=
# Set this when the web workbench is mounted below a public URL prefix.
# AI_FRAME_BASE_PATH=/workf
# Public cloud clients must be listed explicitly; keep local development
# hosts implicit and add only the deployed HTTPS host here.
# AI_FRAME_ALLOWED_HOSTS=wsfile.cn
# AI_FRAME_ALLOWED_ORIGINS=https://wsfile.cn
# Optional server-side TDL session persistence. Keep the file outside the
# public/dist tree and restrict it to the service account (mode 0600).
# AI_FRAME_AUTH_FILE=
# Set to 1 only when AI_FRAME_AUTH_FILE is configured on a trusted server.
# AI_FRAME_PERSIST_AUTH=0
